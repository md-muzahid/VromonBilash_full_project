{
  "info": {
    "name": "VromonBilash - Full Documented API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Safe documented API tests; mutation/OTP/payment cases require QA sandbox."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://admin.vromonbilas.com/v1"
    }
  ],
  "item": [
    {
      "name": "Login - documented sample",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/account/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "account",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"userLoginId\": \"shihab\", \"password\": \"shihab\", \"user_type\": \"R\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const b=pm.response.json(); pm.expect(b).to.have.property(\"status\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - invalid",
